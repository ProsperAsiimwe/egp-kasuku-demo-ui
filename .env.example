# Copy to .env for local Vite.
# Do not put MLOPS, Metabase, HASH_SECRET, or embed secrets here.
# Those stay in egp-mlops-microservice/.env. Vite exposes VITE_* to the browser.

# Used by vite.config.ts to proxy /egp-mlops-microservice and /health.
MLOPS_ORIGIN=http://127.0.0.1:8002

VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=5173
